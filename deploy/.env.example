# Vorlage ohne echte personenbezogene Daten.
# Nur nach IT-Freigabe mit dem IT-Team ausfuellen.
# Datei als deploy/.env speichern; niemals auf GitHub hochladen.

# Welche Uni-Netze duerfen als Client-IP zugreifen? Von IT pruefen lassen.
APP_UNI_CIDRS=

# IP/CIDR des Reverse-Proxys aus Sicht des Containers. IT muss genau messen.
APP_TRUSTED_PROXY_CIDRS=

# Nur fuer die erstmalige Datenbank-Initialisierung.
APP_SUPER_EMAIL=
APP_ADMIN_EMAIL=
APP_ADMIN_NAME=Administrator
